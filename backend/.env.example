# Copy to backend/.env (git-ignored). Never commit real values.

# --- Application ---
TRADINGOS_LOG_LEVEL=INFO
TRADINGOS_LOG_JSON=true
# TRADINGOS_DATA_DIR=../data
# Use the OS certificate store for TLS (needed behind antivirus/corporate HTTPS inspection).
TRADINGOS_USE_SYSTEM_CA=true

# --- OKX DEMO credentials (Phase 4, not used yet) ---
# Create in OKX > Demo trading > API. Permissions: Read + Trade ONLY. NEVER Withdraw.
# Restrict to your IP address where possible.
OKX_DEMO_API_KEY=
OKX_DEMO_API_SECRET=
OKX_DEMO_PASSPHRASE=

# --- LIVE credentials ---
# Intentionally not supported. LIVE trading is hard-disabled in this build.
# See docs/RISK_POLICY.md §7.
